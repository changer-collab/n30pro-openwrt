CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n30-pro=y
CONFIG_TARGET_ALL_DEVICES=n

# 基础组件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-base=y
# 关键: 提供 luci ubus 对象(getFeatures/getVersion/setPassword等), 缺失会导致 LuCI 报 RPCError "Object not found"
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y

# --- 校园网认证: mentohust 命令行(去掉不兼容的LuCI界面,避免RPCError;刷好后再用SSH配置) ---
CONFIG_PACKAGE_mentohust=y

# --- UA2F 防UA检测: 保留二进制(去掉luci界面,避免RPC冲突;用SSH/CLI配置) ---
CONFIG_PACKAGE_ua2f=y
# UA2F 依赖
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libnetfilter-queue=y
CONFIG_PACKAGE_kmod-ipt-nfqueue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_iptables-mod-nfqueue=y
CONFIG_PACKAGE_kmod-nfnetlink=y

# 常用工具
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y

# 主题
CONFIG_PACKAGE_luci-theme-bootstrap=y

# 登录信息
CONFIG_PACKAGE_default-settings=y
